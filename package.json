{
  "name": "clara-monorepo",
  "private": true,
  "type": "module",
  "description": "Workspace root for the Clara design system. Never published.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "lint": "pnpm -r --filter \"./packages/*\" lint",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "check:layers": "node scripts/check-layers.mjs",
    "check:private": "node scripts/check-private.mjs",
    "check:peers": "node scripts/check-peers.mjs",
    "check": "pnpm check:layers && pnpm check:private && pnpm check:peers && pnpm check:exports",
    "check:exports": "node scripts/check-exports.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
