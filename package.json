{
  "name": "clara-monorepo",
  "private": true,
  "type": "module",
  "description": "Workspace root for the Clara design system. Never published.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "vitest run",
    "lint": "pnpm -r --filter \"./packages/*\" lint",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && pnpm -r --filter \"./packages/*\" typecheck",
    "check:layers": "node scripts/check-layers.mjs",
    "check:private": "node scripts/check-private.mjs",
    "check:peers": "node scripts/check-peers.mjs",
    "check": "pnpm check:layers && pnpm check:private && pnpm check:peers && pnpm check:exports && pnpm check:license && pnpm check:bundled-peers && pnpm check:token-output && pnpm check:stylesheets && pnpm check:contrast && pnpm check:foundations && pnpm check:mutation-config && pnpm check:coverage-gate && pnpm check:api && pnpm check:ci-gates && pnpm check:release && pnpm check:prove-guards",
    "check:exports": "node scripts/check-exports.mjs",
    "check:license": "node scripts/check-license.mjs",
    "check:bundled-peers": "node scripts/check-bundled-peers.mjs",
    "check:token-output": "node scripts/check-token-output.mjs",
    "check:prove-guards": "node scripts/prove-guards-fail.mjs",
    "check:attw": "npx --yes @arethetypeswrong/cli --pack packages/tokens --profile node16 --exclude-entrypoints ./tokens.css ./themes/dark.css && npx --yes @arethetypeswrong/cli --pack packages/icons --profile node16 && npx --yes @arethetypeswrong/cli --pack packages/react --profile node16 --exclude-entrypoints ./styles.css",
    "check:publint": "npx --yes publint packages/tokens && npx --yes publint packages/icons && npx --yes publint packages/react",
    "check:stylesheets": "node scripts/check-stylesheets.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "size": "size-limit",
    "check:mutation-config": "node scripts/check-mutation-config.mjs",
    "check:coverage-gate": "node scripts/prove-coverage-gate.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:foundations": "node scripts/check-foundations.mjs",
    "api:update": "node scripts/api-report.mjs --local",
    "api:check": "node scripts/api-report.mjs",
    "check:api": "node scripts/api-report.mjs",
    "check:ci-gates": "node scripts/check-ci-gates.mjs",
    "changeset": "changeset",
    "release:check": "node scripts/check-release.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "picomatch": "^4.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^12.1.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
