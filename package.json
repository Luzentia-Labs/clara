{
  "name": "clara-monorepo",
  "private": true,
  "type": "module",
  "description": "Workspace root for the Clara design system. Never published.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "vitest run",
    "lint": "pnpm -r --filter \"./packages/*\" lint",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && pnpm -r --filter \"./packages/*\" typecheck",
    "check:layers": "node scripts/check-layers.mjs",
    "check:private": "node scripts/check-private.mjs",
    "check:peers": "node scripts/check-peers.mjs",
    "check": "pnpm check:tracked && pnpm check:layers && pnpm check:private && pnpm check:peers && pnpm check:exports && pnpm check:license && pnpm check:bundled-peers && pnpm check:token-output && pnpm check:stylesheets && pnpm check:contrast && pnpm check:foundations && pnpm check:mutation-config && pnpm check:coverage-gate && pnpm check:api && pnpm check:ci-gates && pnpm check:release && pnpm check:client-boundary && pnpm check:overlay-contract && pnpm check:pack && pnpm check:size-budgets && pnpm check:public-tokens && pnpm check:component-css && pnpm check:density-tokens && pnpm check:axe && pnpm check:icons && pnpm check:verification && pnpm check:story-verifiers && pnpm check:keyboard && pnpm check:prove-guards",
    "check:exports": "node scripts/check-exports.mjs",
    "check:license": "node scripts/check-license.mjs",
    "check:bundled-peers": "node scripts/check-bundled-peers.mjs",
    "check:token-output": "node scripts/check-token-output.mjs",
    "check:prove-guards": "node scripts/prove-guards-fail.mjs",
    "check:attw": "npx --yes @arethetypeswrong/cli --pack packages/tokens --profile node16 --exclude-entrypoints ./tokens.css ./themes/dark.css ./themes/compact.css ./tokens.json ./tokens.public.json && npx --yes @arethetypeswrong/cli --pack packages/icons --profile node16 && npx --yes @arethetypeswrong/cli --pack packages/react --profile node16 --exclude-entrypoints ./styles.css",
    "check:publint": "npx --yes publint packages/tokens && npx --yes publint packages/icons && npx --yes publint packages/react",
    "check:stylesheets": "node scripts/check-stylesheets.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && pnpm --filter @clara-internal/storybook build && playwright test",
    "test:mutation": "stryker run",
    "size": "size-limit",
    "check:mutation-config": "node scripts/check-mutation-config.mjs",
    "check:coverage-gate": "node scripts/prove-coverage-gate.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:foundations": "node scripts/check-foundations.mjs",
    "api:update": "node scripts/api-report.mjs --local",
    "api:check": "node scripts/api-report.mjs",
    "check:api": "node scripts/api-report.mjs",
    "check:ci-gates": "node scripts/check-ci-gates.mjs",
    "changeset": "changeset",
    "release:check": "node scripts/check-release.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:client-boundary": "node scripts/check-client-boundary.mjs",
    "check:overlay-contract": "node scripts/check-overlay-contract.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "verify:consumers": "node scripts/verify-consumers.mjs",
    "size:sync": "node scripts/sync-size-budgets.mjs",
    "check:size-budgets": "node scripts/sync-size-budgets.mjs --check",
    "check:public-tokens": "node scripts/check-public-tokens.mjs",
    "check:component-css": "node scripts/check-component-css.mjs",
    "check:density-tokens": "npx vitest run packages/tokens/src/__tests__/density.test.ts --silent",
    "check:geometry": "playwright test e2e/geometry.spec.ts",
    "check:scoping": "pnpm --filter @clara-internal/storybook build && playwright test e2e/scoping.spec.ts",
    "check:storybook": "pnpm --filter @clara-internal/storybook build && playwright test e2e/storybook.spec.ts",
    "check:axe": "npx vitest run packages/react/src/components/__tests__/primitives.test.tsx packages/react/src/components/__tests__/typography.test.tsx packages/react/src/components/__tests__/Table.test.tsx packages/react/src/components/__tests__/matrix.test.tsx packages/react/src/components/Field/__tests__/behaviour.test.tsx packages/react/src/components/Field/__tests__/field.test.tsx packages/react/src/components/Alert/__tests__/alert.test.tsx packages/react/src/components/Badge/__tests__/badge.test.tsx packages/react/src/components/Popover/__tests__/popover.test.tsx packages/react/src/components/Tooltip/__tests__/tooltip.test.tsx packages/react/src/components/Toast/__tests__/toast.test.tsx packages/react/src/components/DropdownMenu/__tests__/dropdown-menu.test.tsx packages/react/src/components/Drawer/__tests__/drawer.test.tsx packages/react/src/components/ProgressBar/__tests__/progress-bar.test.tsx packages/react/src/components/Skeleton/__tests__/skeleton.test.tsx packages/react/src/components/Spinner/__tests__/spinner.test.tsx packages/react/src/components/EmptyState/__tests__/empty-state.test.tsx packages/react/src/components/Tag/__tests__/tag.test.tsx packages/react/src/components/Modal/__tests__/behaviour.test.tsx -t \"axe\" --silent",
    "check:icons": "node scripts/check-icons.mjs",
    "check:verification": "node scripts/check-verification.mjs",
    "check:keyboard": "npx vitest run packages/react/src/components/__tests__/matrix.test.tsx packages/react/src/components/__tests__/primitives.test.tsx packages/react/src/components/Field/__tests__/behaviour.test.tsx packages/react/src/components/Field/__tests__/controls.test.tsx packages/react/src/components/Modal/__tests__/behaviour.test.tsx -t \"keyboard|focus\" --silent",
    "preflight": "node scripts/check-ci-gates.mjs && pnpm build && pnpm typecheck && pnpm check && pnpm check:component-css && pnpm test && pnpm test:coverage && pnpm check:contrast && pnpm check:density-tokens && pnpm check:axe && pnpm check:keyboard && pnpm check:public-tokens && pnpm check:pack && pnpm check:client-boundary && pnpm check:api && pnpm size && pnpm check:latest",
    "latest:sync": "node scripts/sync-latest-numbers.mjs",
    "check:latest": "node scripts/sync-latest-numbers.mjs --check",
    "check:tracked": "node scripts/check-tracked.mjs",
    "check:story-verifiers": "node scripts/check-story-verifiers.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^12.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
