{
  "name": "@luzentialabs/clara-tokens",
  "version": "0.0.0",
  "description": "Clara design tokens: CSS custom properties, typed constants, and the public and pairings manifests.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luzentia-Labs/clara.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens.css": "./dist/tokens.css",
    "./themes/dark.css": "./dist/themes/dark.css",
    "./themes/compact.css": "./dist/themes/compact.css",
    "./tokens.json": "./dist/tokens.json",
    "./tokens.public.json": "./dist/tokens.public.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm clean && pnpm generate && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/lib/finalize-dual.mjs . && vite build --config record.config.mjs",
    "test": "vitest run --root ../.. packages/tokens",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"for(const d of ['dist','build','src/generated','.record-scratch'])require('fs').rmSync(d,{recursive:true,force:true})\"",
    "generate": "node style-dictionary.config.js",
    "generate:ramps": "node generate-ramps.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^4.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
