    "tooltip": {
      "value": "{layer.6}",
      "type": "number",
      "comment": "A Tooltip describes whatever is on top, so it sits above all of it."
    },
    "toast": {
      "value": "{layer.7}",
      "type": "number",
      "comment": "Toasts are the last thing that must never be covered: they may be the only report that something failed."
