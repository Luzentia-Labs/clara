    "raised": {
      "value": "{layer.1}",
      "type": "number",
      "comment": "In-document chrome that must clear its siblings - a sticky table header, a raised card."
    },
    "overlay": {
      "value": "{layer.2}",
      "type": "number",
      "comment": "EVERY portalled surface and its scrim: modal, drawer, popover, menu, listbox. One layer on purpose - which of two overlays is on top depends on which was opened last, and the browser already answers that by DOM order. A per-role constant cannot: a menu must sit under a modal that opens over it, and over a modal opened from inside it."
    },
    "tooltip": {
      "value": "{layer.3}",
      "type": "number",
      "comment": "Above every overlay regardless of open order, because a tooltip describes whatever is currently on top."
    },
    "toast": {
      "value": "{layer.4}",
      "type": "number",
      "comment": "Above everything, because a toast may be the only report that something failed."
    }
  }
