{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "preserve", "strict": true,
    "noEmit": true, "skipLibCheck": true, "allowJs": true, "incremental": true,
    "esModuleInterop": true, "resolveJsonModule": true, "isolatedModules": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
