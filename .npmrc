# A peer conflict must surface at install, not as two Reacts in a consumer's tree
# (US-01M0GMPJ edge case 4). Diagnosing that downstream is far harder than failing here.
strict-peer-dependencies=true

# Isolated node_modules: a package can only import what it declares. This is pnpm's default,
# pinned here so the protection is a decision rather than an inherited accident - a phantom
# dependency is how a package works locally and breaks for every consumer.
node-linker=isolated
