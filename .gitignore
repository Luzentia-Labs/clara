# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
# ...but `test/build/` is SOURCE, not output. The bare `build/` rule swallowed
# `test/build/chunk-placement.test.ts` - the end-to-end Vite build that proves chunk placement
# (D0051) - so it was never committed and CI never ran it, while it passed locally and was cited
# as evidence. A rule that matches by name rather than by what a directory IS.
!test/build/
storybook-static/
*.tsbuildinfo

# Test and coverage
coverage/
test-results/
playwright-report/
blob-report/

# Environment
.env
.env.local
.env.*.local

# Editor and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Turborepo
.turbo/

# Generated token sources (Style Dictionary output, rebuilt by the tokens build)
packages/tokens/src/generated/

# Throwaway fixture written by scripts/prove-coverage-gate.mjs (never committed)
.coverage-fixture/

# Stryker scratch
.stryker-tmp/
reports/

# api-extractor scratch output
packages/*/temp/

# Agent worktrees (EnterWorktree / isolated review agents). Never committed - these are
# full checkouts of this repo, and D0070 requires review agents to run in their own tree.
.claude/worktrees/
